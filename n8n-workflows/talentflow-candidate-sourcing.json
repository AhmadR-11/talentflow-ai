      "id": "node_merge_all",
      "name": "Merge All Platform Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [2440, 300]
    },
    {
      "parameters": {
        "jsCode": "// Collect all candidates from all platforms and deduplicate by email\nconst allItems = $input.all();\n\nlet linkedin = [];\nlet upwork = [];\nlet indeed = [];\n\nfor (const item of allItems) {\n  if (item.json.linkedin_candidates) linkedin = item.json.linkedin_candidates;\n  if (item.json.upwork_candidates) upwork = item.json.upwork_candidates;\n  if (item.json.indeed_candidates) indeed = item.json.indeed_candidates;\n}\n\nconst all = [...linkedin, ...upwork, ...indeed];\n\n// Deduplicate by email (keep first occurrence)\nconst seen = new Set();\nconst deduplicated = all.filter(candidate => {\n  if (!candidate.email) return true; // no email = keep\n  if (seen.has(candidate.email.toLowerCase())) return false;\n  seen.add(candidate.email.toLowerCase());\n  return true;\n});\n\nconsole.log(`Total candidates: ${all.length}, After dedup: ${deduplicated.length}`);\nconsole.log(`LinkedIn: ${linkedin.length}, Upwork: ${upwork.length}, Indeed: ${indeed.length}`);\n\nreturn [{\n  json: {\n    all_candidates: deduplicated,\n    total: deduplicated.length,\n    breakdown: {\n      linkedin: linkedin.length,\n      upwork: upwork.length,\n      indeed: indeed.length\n    }\n  }\n}];"
      },
      "id": "node_merge_deduplicate",
      "name": "Merge & Deduplicate Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2660, 300]
    },
